NODE_ENV=development
PORT=3000

# Application connections always use the restricted runtime role.
DATABASE_URL=postgresql://lodgekeeper_app:lodgekeeper_app@localhost:5433/lodgekeeper
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_DEBUG=false

# Only migration commands use the owning role.
MIGRATION_DATABASE_URL=postgresql://lodgekeeper_owner:lodgekeeper_owner@localhost:5433/lodgekeeper

# Local PostgreSQL container bootstrap.
POSTGRES_DB=lodgekeeper
POSTGRES_TEST_DB=lodgekeeper_test
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=postgres
MIGRATION_DB_USER=lodgekeeper_owner
MIGRATION_DB_PASSWORD=lodgekeeper_owner
APP_DB_USER=lodgekeeper_app
APP_DB_PASSWORD=lodgekeeper_app
