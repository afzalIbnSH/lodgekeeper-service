NODE_ENV=development
PORT=3000

# Application connections always use the restricted runtime role.
DATABASE_URL=postgresql://lodgekeeper_app:lodgekeeper_app@localhost:5433/lodgekeeper
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_DEBUG=false

# Opaque, database-backed authentication sessions.
AUTH_SESSION_COOKIE_NAME=lodgekeeper_session
# AUTH_SESSION_COOKIE_SECURE defaults to true in production and false otherwise.
AUTH_SESSION_TTL_SECONDS=604800

# Only migration commands use the owning role.
MIGRATION_DATABASE_URL=postgresql://lodgekeeper_owner:lodgekeeper_owner@localhost:5433/lodgekeeper

# The standalone provisioning command is the only consumer of this connection.
PROVISIONING_DATABASE_URL=postgresql://lodgekeeper_provisioner:lodgekeeper_provisioner@localhost:5433/lodgekeeper
APP_PUBLIC_URL=http://localhost:3000
INVITATION_TTL_HOURS=48
INVITATION_DELIVERY=console

# Required only when INVITATION_DELIVERY=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM="Lodgekeeper <no-reply@example.com>"
# SMTP_USER=
# SMTP_PASSWORD=

# Local PostgreSQL container bootstrap.
POSTGRES_DB=lodgekeeper
POSTGRES_TEST_DB=lodgekeeper_test
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=postgres
MIGRATION_DB_USER=lodgekeeper_owner
MIGRATION_DB_PASSWORD=lodgekeeper_owner
APP_DB_USER=lodgekeeper_app
APP_DB_PASSWORD=lodgekeeper_app
PROVISIONER_DB_PASSWORD=lodgekeeper_provisioner
